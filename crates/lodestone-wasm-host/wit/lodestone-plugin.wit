// The Lodestone plugin ABI — issue #173's surface, vendored in-repo as the
// single source of truth for both sides of the boundary.
//
// READ THIS BEFORE EDITING. Three properties are load-bearing and none of them
// is obvious from the syntax:
//
//  1. **Every `import` in the world below is a capability**, and the host grants
//     one by adding it to the wasmtime `Linker` (`src/host.rs`). A guest that
//     never calls an import does not import it: the wasm linker drops the
//     unreferenced `extern` and `wit-component` encodes a component whose
//     import list contains only what the guest actually uses. **Measured**, not
//     assumed — see `docs/wasm-plugin-host.md` §"The capability probe" for the
//     exact two component import lists. That is why capability enforcement here
//     is structural rather than advisory: a plugin whose manifest declares no
//     filesystem capability but which calls `filesystem.read-file` anyway fails
//     at *instantiation*, because the interface is absent from the linker.
//
//  2. **Events are pushed as an argument and actions come back as a return
//     value** — deliberately not the `poll-events`/`submit-actions` import pair
//     `docs/plans/runtime-plugin-loading.md` first proposed. Two reasons, and
//     the second is the important one. It is one boundary crossing per guest per
//     tick instead of three; and a return value **cannot** be produced outside
//     the guest's own tick window, whereas a `submit-actions` import could be
//     called from anywhere the guest reaches, which would fork the single-writer
//     invariant `docs/plugin-api.md`'s clause 2 depends on. The host's conductor
//     stays the one writer of `ActionQueue` by construction.
//
//  3. **`event` and `action` are a curated subset of `lodestone_model`'s
//     `ClientEvent` (~110 variants) and `ClientAction` (~55)**, not a mirror of
//     them. A full mirror is the staleness factory `lodestone_ecs::events`'s own
//     module doc refuses for exactly this reason: two enums drift and nothing
//     forces the second to grow. The subset grows deliberately, and a guest
//     cannot silently miss an event it wanted — it must *name* the event kinds
//     it observes in its `plugin.toml`, and a kind this world does not define is
//     a loud manifest rejection at load time.

package lodestone:plugin@0.7.0;

/// The vocabulary itself: the intent doctrine's own observe/act types, lifted
/// into WIT. Nothing here is invented for wasm — every record below is a
/// field-for-field copy of something that already crosses the native plugin
/// seam as a `Clone` value or a POD struct.
interface types {
    /// A guest-local opaque handle returned by the scheduler. The host preserves
    /// it when a repeating task fires so the callback can cancel itself.
    type task-id = u64;

    record block-break-verdict {
        pos: block-pos,
        state-id: option<u32>,
    }

    record block-place-verdict {
        pos: block-pos,
    }

    record entity-damage-verdict {
        target-entity-id: s32,
    }

    record inventory-click-verdict {
        window-id: s32,
        slot: s32,
        button: s32,
    }

    record player-move-verdict {
        moving: bool,
        jumping: bool,
        sprinting: bool,
    }

    record player-interact-verdict {
        pos: option<block-pos>,
        target-entity-id: option<s32>,
    }

    /// The copy-only context for one action the client is about to commit.
    ///
    /// This deliberately contains no world handle, entity handle, or callback:
    /// `on-verdict` runs while the tick owner may already hold the world guard.
    /// A guest can decide from this value and state it owns, but cannot re-enter
    /// the client world through the ABI.
    variant verdict-context {
        block-break(block-break-verdict),
        block-place(block-place-verdict),
        entity-damage(entity-damage-verdict),
        inventory-click(inventory-click-verdict),
        player-move(player-move-verdict),
        player-interact(player-interact-verdict),
    }

    /// The only synchronous cancellation result. `deny` stops the action before
    /// prediction and before egress; there is no mutation channel in this call.
    enum plugin-verdict {
        allow,
        deny,
    }

    /// `lodestone_model::event::ChatKind`.
    enum chat-kind {
        chat,
        system,
        game-info,
    }

    /// `lodestone_model::ClientEvent::Chat`.
    ///
    /// `text` is the *plain* string (`Text::to_plain_string`), not the styled
    /// component tree. A guest that needs styling is a v0.2 conversation; the
    /// flattening is deliberate and lossy, and is recorded as such in
    /// `docs/wasm-plugin-host.md` §"Where the mapping is lossy".
    record chat-message {
        text: string,
        kind: chat-kind,
    }

    /// `lodestone_model::ClientEvent::HealthChanged`.
    record health {
        health: f32,
        food: s32,
        saturation: f32,
    }

    /// Section coordinates — block coordinate `>> 4` on every axis, exactly
    /// `lodestone_model::SectionPos`.
    record section-pos {
        x: s32,
        y: s32,
        z: s32,
    }

    /// One section-relative cell, each component `0..16`.
    record block-offset {
        x: u8,
        y: u8,
        z: u8,
    }

    /// `lodestone_model::ClientEvent::SectionBlocksChanged`.
    ///
    /// The section-granular event, not the column-granular one: a guest
    /// watching for redstone edits must not pay a chunk-sized cost per tick.
    record section-blocks-changed {
        section: section-pos,
        blocks: list<block-offset>,
    }

    /// A block position in world coordinates — `lodestone_model::BlockPos`.
    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }

    /// One observation the host delivers. The variant set is the curated subset
    /// described in this file's header; each arm names the `ClientEvent` it is
    /// lifted from, and `crates/lodestone-wasm-host/src/abi.rs` is the one place
    /// the lift happens.
    variant event {
        /// `ClientEvent::Chat` — capability `observe:chat`.
        chat(chat-message),
        /// `ClientEvent::HealthChanged` — capability `observe:health`.
        health-changed(health),
        /// `ClientEvent::SectionBlocksChanged` — capability `observe:blocks`.
        blocks-changed(section-blocks-changed),
    }

    /// Which hand — `lodestone_model::common::Hand`.
    enum hand {
        main,
        off,
    }

    /// A copied look target in the same degree convention as the local-player
    /// intent.  The host owns clamping and committing it to simulation state.
    record look-intent {
        yaw: f32,
        pitch: f32,
    }

    /// A copied local-player movement request.  Axes are digital input values;
    /// the host clamps them to `[-1, 1]` and owns the remaining simulation state.
    record movement-intent {
        forward: f32,
        strafe: f32,
        jump: bool,
        sneak: bool,
        sprint: bool,
    }

    /// One thing a guest wants done. Protocol actions lower onto `ClientAction`
    /// and preserve submission order in `lodestone_ecs::player::ActionQueue`;
    /// copied intent actions are applied through their existing local-player
    /// consumers before physics.
    variant action {
        /// `ClientAction::SendChat` — capability `act:chat`.
        send-chat(string),
        /// `ClientAction::SendCommand` — capability `act:chat`.
        send-command(string),
        /// `ClientAction::SwingArm` — capability `act:interact`.
        swing-arm(hand),
        /// Install or remove the local player's look intent — capability
        /// `act:look`.  `none` returns rotation ownership to normal input.
        set-look(option<look-intent>),
        /// Override this tick's copied movement intent — capability
        /// `act:movement`. `none` leaves the normal controller input intact.
        set-movement(option<movement-intent>),
    }

    /// A root command a guest wants the host to register. The host supplies one
    /// greedy tail argument so a command handler receives the canonical command
    /// line, including every argument after this root.
    record command-spec {
        name: string,
        description: string,
        aliases: list<string>,
        permission: option<string>,
    }

    /// The result of handling a plugin-owned command. A successful result is
    /// the integer command result used by command chaining; a failure is shown
    /// to the command sender.
    variant command-outcome {
        success(s32),
        failure(string),
    }

    /// The player or server identity selected by command dispatch. This is a
    /// display value, not a capability: native permission filtering completes
    /// before a guest sees it.
    record command-context {
        sender-name: string,
        execution: option<command-execution>,
    }

    /// The copied, value-only state supplied by a contextual command. Direct
    /// command roots carry `none` in `command-context.execution`.
    record command-execution {
        entity: option<command-entity>,
        position: command-position,
        rotation: command-rotation,
        dimension: string,
        anchor: command-anchor,
        permission-level: u8,
    }

    /// The selected entity's stable values, without an engine handle or UUID.
    record command-entity {
        entity-id: s32,
        username: string,
    }

    record command-position {
        x: f64,
        y: f64,
        z: f64,
    }

    record command-rotation {
        yaw: f32,
        pitch: f32,
    }

    enum command-anchor {
        feet,
        eyes,
    }

    /// What a guest says about itself at `init`. Cross-checked against the
    /// `plugin.toml` beside it: a mismatch is a load-time rejection, because a
    /// manifest that disagrees with the module it ships next to is exactly the
    /// case where trusting either one silently is wrong.
    record plugin-info {
        name: string,
        version: string,
        /// The world version this guest was built against, e.g.
        /// `"lodestone:plugin@0.7.0"`.
        abi: string,
        /// Root commands this guest wants the host to register. The host only
        /// installs them when the manifest grants `commands:register`.
        commands: list<command-spec>,
    }

    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }
}

/// Capability `log` — granted to every plugin. The host owns the sink, so this
/// is not an escape hatch: a guest cannot reach a file or a terminal through it,
/// only the host's own `tracing` subscriber, tagged with the plugin's name.
interface logging {
    use types.{log-level};

    log: func(level: log-level, message: string);
}

/// Capability `fs:read` — **never granted by default**, and the subject of the
/// denial gate in `tests/capability_denial.rs`.
///
/// It exists in this world precisely so that "a plugin that declares no
/// filesystem capability cannot touch the filesystem" is a *tested* claim about
/// a guest that genuinely tries, rather than an observation about guests that
/// never do. `tests/support`'s misbehaving fixture calls this function; the host
/// refuses to instantiate it.
interface filesystem {
    read-file: func(path: string) -> result<list<u8>, string>;
}

/// Capability `schedule:tasks` — denied unless the plugin manifest requests it
/// and host policy grants it. Delays are measured in host ticks; zero and one
/// both mean the next tick, and a zero repeat period is clamped to one tick.
interface scheduler {
    use types.{task-id};

    schedule-once: func(delay-ticks: u32, token: u64) -> task-id;
    schedule-repeating: func(
        delay-ticks: u32,
        period-ticks: u32,
        token: u64,
    ) -> task-id;
    cancel: func(id: task-id);
}

world plugin {
    use types.{action, command-context, command-outcome, event, plugin-info, plugin-verdict, task-id, verdict-context};

    import logging;
    import filesystem;
    import scheduler;

    /// Called once, immediately after instantiation. The returned
    /// [`plugin-info`] is cross-checked against the manifest.
    export init: func() -> plugin-info;

    /// Called once per `GameTick`, with this tick's subscribed events, returning
    /// this tick's actions. Called even when `events` is empty, so a guest can
    /// act on its own clock.
    export on-tick: func(events: list<event>) -> list<action>;

    /// Called when a task scheduled through the `scheduler` import becomes due.
    /// `token` is guest-defined state that crosses the otherwise stateless ABI.
    export on-task: func(id: task-id, token: u64) -> list<action>;

    /// Called synchronously at a typed action-veto point. Guests run in stable
    /// host load order; the first `deny` (or failed guest call) ends this ask.
    export on-verdict: func(context: verdict-context) -> plugin-verdict;

    /// Handle one command this guest declared from `init`. `input` is canonical:
    /// aliases have already been rewritten and a leading slash removed. This call
    /// receives no world access or engine handle, so it remains safe while the
    /// native dispatcher owns the world borrow. `context` is a copy-only
    /// snapshot after native alias and permission resolution.
    export on-command: func(input: string, context: command-context) -> command-outcome;
}
